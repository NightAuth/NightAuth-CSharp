<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="NightAuthWpf.AuthWindow"
        Title="NightAuth"
        Width="1020" Height="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanMinimize">

    <Border x:Name="RootBorder" Background="{StaticResource BgDarkBrush}" CornerRadius="16" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
            SizeChanged="RootBorder_SizeChanged" MouseDown="Window_MouseDown">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="0" Opacity="0.55" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header -->
            <Border Grid.Row="0" Background="{StaticResource CardHeaderBgBrush}" CornerRadius="16,16,0,0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" MouseDown="TitleBar_MouseDown">
                <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Image Source="logo.png" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="NIGHTAUTH" FontSize="14" FontWeight="Black" Foreground="White" />
                            <TextBlock Text="NATIVE C# / .NET SECURITY CLIENT" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0">
                        <Button Content="−" Click="BtnMinimize_Click" Style="{StaticResource TitleBarButton}" />
                        <Button Content="✕" Click="BtnClose_Click" Style="{StaticResource TitleBarCloseButton}" Margin="0,0,6,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Body Split Screen -->
            <Grid Grid.Row="1" Margin="20,16,20,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="390" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Hero Panel -->
                <Border Grid.Column="0" Background="#0D101A" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="24,22">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- App Status Badge -->
                        <Border Grid.Row="0" Background="#111A2E" BorderBrush="#253E70" BorderThickness="1" CornerRadius="6" Padding="10,4" HorizontalAlignment="Left" Margin="0,0,0,12">
                            <TextBlock Text="●  ZERO-TRUST TELEMETRY" FontSize="10" FontWeight="Bold" Foreground="#93C5FD" />
                        </Border>

                        <!-- Titles -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,8">
                            <TextBlock Text="Enterprise Cloud" FontSize="21" FontWeight="ExtraBold" Foreground="White" />
                            <TextBlock Text="Licensing &amp; Identity" FontSize="21" FontWeight="ExtraBold" Foreground="#60A5FA" />
                        </StackPanel>

                        <!-- Subtitle -->
                        <TextBlock Grid.Row="2" Text="Cryptographically bound sessions, hardware fingerprinting, real-time cloud variables, and tamper-evident delivery."
                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,18" LineHeight="17" />

                        <!-- 4 Feature Cards matching C Desktop -->
                        <StackPanel Grid.Row="3" Margin="0,0,0,10">
                            <!-- Feature 1 -->
                            <Border Background="#0E0F14" BorderBrush="#1E2434" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="22" Height="22" Background="#0C2A20" BorderBrush="#185C46" BorderThickness="1" CornerRadius="5" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="✓" Foreground="#22C55E" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <TextBlock Text="Instant License Key &amp; Account Activation" FontSize="11" FontWeight="Bold" Foreground="White" />
                                        <TextBlock Text="Zero-trust session negotiation with anti-replay protection" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Feature 2 -->
                            <Border Background="#0E0F14" BorderBrush="#1E2434" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="22" Height="22" Background="#0C2A20" BorderBrush="#185C46" BorderThickness="1" CornerRadius="5" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="✓" Foreground="#22C55E" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <TextBlock Text="Automatic Device HWID Binding &amp; Reset" FontSize="11" FontWeight="Bold" Foreground="White" />
                                        <TextBlock Text="Hardware fingerprint locking with self-service reset support" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Feature 3 -->
                            <Border Background="#0E0F14" BorderBrush="#1E2434" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="22" Height="22" Background="#0C2A20" BorderBrush="#185C46" BorderThickness="1" CornerRadius="5" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="✓" Foreground="#22C55E" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <TextBlock Text="Cloud Variables, Live Chat &amp; File Delivery" FontSize="11" FontWeight="Bold" Foreground="White" />
                                        <TextBlock Text="Deliver encrypted configuration and assets on demand" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Feature 4 -->
                            <Border Background="#0E0F14" BorderBrush="#1E2434" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="22" Height="22" Background="#0C2A20" BorderBrush="#185C46" BorderThickness="1" CornerRadius="5" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="✓" Foreground="#22C55E" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <TextBlock Text="Two-Factor (2FA) Account Protection" FontSize="11" FontWeight="Bold" Foreground="White" />
                                        <TextBlock Text="Time-based OTP security with instant identity verification" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Bound Application & Device Card (Bottom) -->
                        <Border Grid.Row="5" Background="#0E0F14" BorderBrush="#1E2434" BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="BOUND APPLICATION &amp; DEVICE" FontSize="9.5" FontWeight="ExtraBold" Foreground="#60A5FA" Margin="0,0,0,4" />
                                <TextBlock x:Name="LblBoundAppName" Text="Unconfigured" FontSize="12.5" FontWeight="Bold" Foreground="White" Margin="0,0,0,3" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="LblLocalHwid" Text="HWID: Loading..." FontFamily="Consolas, monospace" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Right Column: Action Card -->
                <Border Grid.Column="1" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Margin="16,0,0,0" Padding="28,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Segmented Tabs -->
                        <Border x:Name="LoginSegmentBorder" Grid.Row="0" Background="#0A0D17" BorderBrush="#1C2133"
                                BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <RadioButton x:Name="TabCredentials" Grid.Column="0" Content="Sign In"
                                             Style="{StaticResource SegmentedTab}" Checked="TabCredentials_Checked" />
                                <RadioButton x:Name="TabRegister" Grid.Column="1" Content="Register"
                                             Style="{StaticResource SegmentedTab}" Checked="TabRegister_Checked" />
                                <RadioButton x:Name="TabLicenseOnly" Grid.Column="2" Content="License"
                                             Style="{StaticResource SegmentedTab}" Checked="TabLicenseOnly_Checked" />
                                <RadioButton x:Name="TabUpgrade" Grid.Column="3" Content="Upgrade"
                                             Style="{StaticResource SegmentedTab}" Checked="TabUpgrade_Checked" />
                                <RadioButton x:Name="TabResetHwid" Grid.Column="4" Content="Reset HWID"
                                             Style="{StaticResource SegmentedTab}" Checked="TabResetHwid_Checked" />
                            </Grid>
                        </Border>

                        <!-- Section Header -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,14">
                            <TextBlock x:Name="AuthHeadingText" Text="Sign in to your account" FontSize="17" FontWeight="Bold" Foreground="White" Margin="0,0,0,3" />
                            <TextBlock x:Name="AuthSubheadingText" Text="Enter your credentials to negotiate a secure zero-trust session." FontSize="12" Foreground="#7E8BA6" TextWrapping="Wrap" LineHeight="17" />
                        </StackPanel>

                        <!-- Form Fields -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="AuthContent" VerticalAlignment="Top">

                                <!-- Username -->
                                <StackPanel x:Name="FieldUsernamePanel" Margin="0,0,0,11">
                                    <TextBlock x:Name="LblUsernameField" Text="USERNAME" Style="{StaticResource FieldLabel}" Margin="2,0,0,4" />
                                    <Grid>
                                        <TextBox x:Name="TxtUsername" Style="{StaticResource NightAuthIconTextBox}" />
                                        <TextBlock Text="&#xE77B;" Style="{StaticResource InputIcon}" />
                                        <TextBlock Text="Enter your username" Style="{StaticResource PlaceholderText}" Margin="34,0,12,0">
                                            <TextBlock.Visibility>
                                                <MultiBinding Converter="{StaticResource PlaceholderVisibility}">
                                                    <Binding Path="IsFocused" ElementName="TxtUsername" />
                                                    <Binding Path="Text" ElementName="TxtUsername" />
                                                </MultiBinding>
                                            </TextBlock.Visibility>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>

                                <!-- Password -->
                                <StackPanel x:Name="FieldPasswordPanel" Margin="0,0,0,11">
                                    <Grid Margin="2,0,0,4">
                                        <TextBlock Text="PASSWORD" Style="{StaticResource FieldLabel}" HorizontalAlignment="Left" />
                                        <Button x:Name="BtnForgotLink" Content="Forgot password?" Style="{StaticResource LinkButton}"
                                                HorizontalAlignment="Right" Click="BtnForgotLink_Click" />
                                    </Grid>
                                    <Grid>
                                        <PasswordBox x:Name="TxtPassword" Style="{StaticResource NightAuthPasswordBox}" PasswordChanged="TxtPassword_PasswordChanged" />
                                        <TextBox x:Name="TxtPasswordVisible" Style="{StaticResource NightAuthIconTrailTextBox}" Visibility="Collapsed" TextChanged="TxtPasswordVisible_TextChanged" />
                                        <TextBlock Text="&#xE72E;" Style="{StaticResource InputIcon}" />
                                        <TextBlock x:Name="PasswordPlaceholder" Text="Enter your password" Style="{StaticResource PlaceholderText}" Margin="34,0,36,0" />
                                        <Button x:Name="BtnTogglePassword" Style="{StaticResource ShowPasswordButton}" Click="BtnTogglePassword_Click" ToolTip="Show / Hide Password">
                                            <Grid Width="16" Height="16">
                                                <Canvas x:Name="EyeOpenIcon" Width="16" Height="16">
                                                    <Path Data="M 1.5,8 C 3,4.5 6,2.5 8,2.5 C 10,2.5 13,4.5 14.5,8 C 13,11.5 10,13.5 8,13.5 C 6,13.5 3,11.5 1.5,8 Z"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                          StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                    <Path Data="M 8,6 A 2,2 0 1 1 8,10 A 2,2 0 1 1 8,6"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                          StrokeThickness="1.4" />
                                                </Canvas>
                                                <Canvas x:Name="EyeClosedIcon" Width="16" Height="16" Visibility="Collapsed">
                                                    <Path Data="M 7.1,2.6 C 7.4,2.5 7.7,2.5 8,2.5 C 10,2.5 13,4.5 14.5,8 C 13.9,9.4 12.8,10.6 11.6,11.5 M 9.4,9.4 A 2,2 0 0 1 6.6,6.6 M 4.4,4.4 C 3.1,5.3 2.1,6.5 1.5,8 C 3,11.5 6,13.5 8,13.5 C 9.1,13.5 10.1,13.1 11,12.5 M 1.5,1.5 L 14.5,14.5"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                          StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                </Canvas>
                                            </Grid>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <!-- 2FA Code -->
                                <StackPanel x:Name="FieldTotpPanel" Margin="0,0,0,11" Visibility="Collapsed">
                                    <TextBlock Text="2FA CODE (OPTIONAL)" Style="{StaticResource FieldLabel}" Margin="2,0,0,4" />
                                    <Grid>
                                        <TextBox x:Name="TxtTotp" Style="{StaticResource NightAuthIconTextBox}" MaxLength="10" />
                                        <TextBlock Text="&#xE72E;" Style="{StaticResource InputIcon}" />
                                        <TextBlock Text="Enter 6-digit code (if enabled)" Style="{StaticResource PlaceholderText}" Margin="34,0,12,0">
                                            <TextBlock.Visibility>
                                                <MultiBinding Converter="{StaticResource PlaceholderVisibility}">
                                                    <Binding Path="IsFocused" ElementName="TxtTotp" />
                                                    <Binding Path="Text" ElementName="TxtTotp" />
                                                </MultiBinding>
                                            </TextBlock.Visibility>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>

                                <!-- Email -->
                                <StackPanel x:Name="FieldEmailPanel" Margin="0,0,0,11" Visibility="Collapsed">
                                    <TextBlock x:Name="LblEmailField" Text="EMAIL" Style="{StaticResource FieldLabel}" Margin="2,0,0,4" />
                                    <Grid>
                                        <TextBox x:Name="TxtEmail" Style="{StaticResource NightAuthIconTextBox}" />
                                        <TextBlock Text="&#xE715;" Style="{StaticResource InputIcon}" />
                                        <TextBlock Text="Enter your email" Style="{StaticResource PlaceholderText}" Margin="34,0,12,0">
                                            <TextBlock.Visibility>
                                                <MultiBinding Converter="{StaticResource PlaceholderVisibility}">
                                                    <Binding Path="IsFocused" ElementName="TxtEmail" />
                                                    <Binding Path="Text" ElementName="TxtEmail" />
                                                </MultiBinding>
                                            </TextBlock.Visibility>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>

                                <!-- Reset Token -->
                                <StackPanel x:Name="FieldTokenPanel" Margin="0,0,0,11" Visibility="Collapsed">
                                    <TextBlock Text="RESET TOKEN" Style="{StaticResource FieldLabel}" Margin="2,0,0,4" />
                                    <Grid>
                                        <TextBox x:Name="TxtResetToken" Style="{StaticResource NightAuthIconTextBox}" />
                                        <TextBlock Text="&#xE8D7;" Style="{StaticResource InputIcon}" />
                                        <TextBlock Text="Enter the reset token received by email" Style="{StaticResource PlaceholderText}" Margin="34,0,12,0">
                                            <TextBlock.Visibility>
                                                <MultiBinding Converter="{StaticResource PlaceholderVisibility}">
                                                    <Binding Path="IsFocused" ElementName="TxtResetToken" />
                                                    <Binding Path="Text" ElementName="TxtResetToken" />
                                                </MultiBinding>
                                            </TextBlock.Visibility>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>

                                <Button x:Name="BtnForgotToggleToken" Content="Already have a reset token?" Style="{StaticResource LinkButton}"
                                        HorizontalAlignment="Right" Click="BtnForgotToggleToken_Click" Margin="0,-4,0,8" Visibility="Collapsed" />

                                <!-- License Key -->
                                <StackPanel x:Name="FieldLicensePanel" Margin="0,0,0,6" Visibility="Collapsed">
                                    <TextBlock Text="LICENSE KEY" Style="{StaticResource FieldLabel}" Margin="2,0,0,4" />
                                    <Grid>
                                        <TextBox x:Name="TxtLicenseKey" Style="{StaticResource NightAuthIconTextBox}" />
                                        <TextBlock Text="&#xE8EC;" Style="{StaticResource InputIcon}" />
                                        <TextBlock Text="Enter your license key" Style="{StaticResource PlaceholderText}" Margin="34,0,12,0">
                                            <TextBlock.Visibility>
                                                <MultiBinding Converter="{StaticResource PlaceholderVisibility}">
                                                    <Binding Path="IsFocused" ElementName="TxtLicenseKey" />
                                                    <Binding Path="Text" ElementName="TxtLicenseKey" />
                                                </MultiBinding>
                                            </TextBlock.Visibility>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>
                                <TextBlock x:Name="LicenseHintText" Text="First time using this key creates your account automatically — no separate registration needed."
                                           FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="2,4,0,8" Visibility="Collapsed" />

                                <!-- Submit Button -->
                                <Button x:Name="BtnAuthSubmit" Style="{StaticResource PrimaryButton}"
                                        Click="BtnAuthSubmit_Click" HorizontalAlignment="Stretch" Margin="0,8,0,0" Padding="16,9">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas x:Name="BtnSpinnerGlyph" Width="14" Height="14" Margin="0,0,8,0" Visibility="Collapsed"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Canvas.RenderTransform>
                                                <RotateTransform x:Name="SpinnerRotate" Angle="0" />
                                            </Canvas.RenderTransform>
                                            <Path Data="M 7,1 A 6,6 0 1 1 6.99,1" Stroke="#ffffff" StrokeThickness="1.7" Opacity="0.25" />
                                            <Path Data="M 7,1 A 6,6 0 0 1 13,7" Stroke="#ffffff" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Canvas>
                                        <TextBlock x:Name="BtnSubmitText" Text="Sign In" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <TextBlock x:Name="AuthErrorText" Foreground="{StaticResource ErrorBrush}" FontSize="12" TextAlignment="Center"
                                           TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />

                                <Button x:Name="BtnSwitchMode" Content="Need an account? Register" Style="{StaticResource LinkButton}"
                                        HorizontalAlignment="Center" Click="BtnSwitchMode_Click" Margin="0,12,0,0" />
                            </StackPanel>
                        </ScrollViewer>


                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>

